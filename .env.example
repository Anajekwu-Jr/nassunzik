# ==============================================================================
# NASS UNIZIK Departmental Portal - Environment Variables Template
# ==============================================================================
# IMPORTANT SECURITY RULE:
# - Variables prefixed with `VITE_` are embedded into the public client bundle
#   during `npm run build` on Cloudflare Pages. NEVER put private secrets or
#   admin credentials in `VITE_*` variables.
# - Server-only variables below apply only when running the Express backend
#   (`node backend/server.js`) locally or on a Node host.

# --- Optional Frontend Client Variables (Cloudflare Pages / Vite) ---
# External Node API backend URL if deploying the Express API separately from
# Cloudflare Pages static hosting. Leave unset to use same-origin `/api` and
# automatic offline/static JSON fallbacks in `/data/`.
# VITE_API_BASE_URL="https://api.yourdomain.com/api"

# Firebase Check Note:
# This codebase currently uses Express + SQLite + static JSON snapshots and does
# NOT use Firebase SDKs. If Firebase is integrated in the future, configure
# public client keys strictly using `VITE_FIREBASE_*` names:
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""

# --- Server-Only Variables (Express Backend — NEVER prefix with VITE_) ---
# GEMINI_API_KEY: Required for Sam AI assistant endpoints on the Node backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public canonical URL of the deployed application.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing secret for admin authentication tokens.
JWT_SECRET="super_secure_nass_unizik_jwt_secret_key_2026_change_in_production"

# Server listening port (local/Node runtime)
PORT=3000
