{
  "version": 2,
  "framework": null,
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/downloads/(.*)",
      "destination": "/downloads/$1"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/academia",
      "destination": "/academia.html"
    },
    {
      "source": "/academics",
      "destination": "/academia.html"
    },
    {
      "source": "/careers",
      "destination": "/about.html"
    },
    {
      "source": "/careers.html",
      "destination": "/about.html"
    },
    {
      "source": "/where-statistics-can-take-you",
      "destination": "/about.html"
    },
    {
      "source": "/where-can-statistics-take-you",
      "destination": "/about.html"
    },
    {
      "source": "/siwes",
      "destination": "/siwes.html"
    },
    {
      "source": "/projects",
      "destination": "/projects.html"
    },
    {
      "source": "/resources",
      "destination": "/projects.html"
    },
    {
      "source": "/timetable",
      "destination": "/timetable.html"
    },
    {
      "source": "/administration",
      "destination": "/administration.html"
    },
    {
      "source": "/staff",
      "destination": "/administration.html"
    },
    {
      "source": "/staff-profile",
      "destination": "/staff-profile.html"
    },
    {
      "source": "/profile",
      "destination": "/staff-profile.html"
    },
    {
      "source": "/nass",
      "destination": "/nass.html"
    },
    {
      "source": "/executives",
      "destination": "/nass.html"
    },
    {
      "source": "/events",
      "destination": "/events.html"
    },
    {
      "source": "/news",
      "destination": "/news.html"
    },
    {
      "source": "/archive",
      "destination": "/archive.html"
    },
    {
      "source": "/gallery",
      "destination": "/archive.html"
    },
    {
      "source": "/past-questions",
      "destination": "/past-questions.html"
    },
    {
      "source": "/pastquestions",
      "destination": "/past-questions.html"
    },
    {
      "source": "/contacts",
      "destination": "/contacts.html"
    },
    {
      "source": "/contact",
      "destination": "/contacts.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app.html",
      "destination": "/app.html"
    },
    {
      "source": "/website",
      "destination": "/website.html"
    },
    {
      "source": "/website.html",
      "destination": "/website.html"
    },
    {
      "source": "/portal",
      "destination": "/website.html"
    },
    {
      "source": "/home",
      "destination": "/website.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.mobileconfig",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-apple-aspen-config; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"NASS_UNIZIK.mobileconfig\""
        }
      ]
    },
    {
      "source": "/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"NASS_UNIZIK.apk\""
        }
      ]
    },
    {
      "source": "/(.*)\\.zip",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/zip"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
