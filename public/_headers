# NASS UNIZIK - Cloudflare Pages Custom HTTP Headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*.mobileconfig
  Content-Type: application/x-apple-aspen-config; charset=utf-8
  Content-Disposition: attachment; filename="NASS_UNIZIK.mobileconfig"

/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="NASS_UNIZIK.apk"

/*.zip
  Content-Type: application/zip
  Content-Disposition: attachment

/manifest.json
  Content-Type: application/manifest+json; charset=utf-8

/sw.js
  Content-Type: application/javascript; charset=utf-8
  Service-Worker-Allowed: /
  Cache-Control: no-cache, no-store, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
